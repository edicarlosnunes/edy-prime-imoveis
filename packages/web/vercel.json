{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/joaquim/venda",
      "destination": "/joaquim-venda.html"
    },
    {
      "source": "/joaquim/venda/",
      "destination": "/joaquim-venda.html"
    },
    {
      "source": "/joaquim/locacao",
      "destination": "/joaquim-locacao.html"
    },
    {
      "source": "/joaquim/locacao/",
      "destination": "/joaquim-locacao.html"
    },
    {
      "source": "/locacao/",
      "destination": "/locacao.html"
    },
    {
      "source": "/locacao",
      "destination": "/locacao.html"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/handler?__path=/api/:path*"
    },
    {
      "source": "/feed/:file",
      "destination": "/api/handler?__path=/api/feed/:file"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/handler?__path=/api/sitemap.xml"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/handler?__path=/api/robots.txt"
    },
    {
      "source": "/imovel/:slug",
      "destination": "/api/handler?__path=/api/prerender/imovel/:slug"
    },
    {
      "source": "/cadastro",
      "destination": "/cadastro.html"
    },
    {
      "source": "/cadastro/",
      "destination": "/cadastro.html"
    },
    {
      "source": "/autorizacao",
      "destination": "/autorizacao.html"
    },
    {
      "source": "/autorizacao/",
      "destination": "/autorizacao.html"
    },
    {
      "source": "/autorizacao-venda",
      "destination": "/autorizacao.html"
    },
    {
      "source": "/autorizar",
      "destination": "/autorizacao.html"
    },
    {
      "source": "/((?!api).*)",
      "destination": "/index.html"
    }
  ],
  "buildCommand": "bun vercel-api/build.ts && bunx vite build"
}
