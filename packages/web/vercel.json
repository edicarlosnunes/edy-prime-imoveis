{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/handler?__path=/api/:path*"
    },
    {
      "source": "/feed/:file",
      "destination": "/api/handler?__path=/api/feed/:file"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/handler?__path=/api/sitemap.xml"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/handler?__path=/api/robots.txt"
    },
    {
      "source": "/imovel/:slug",
      "destination": "/api/handler?__path=/api/prerender/imovel/:slug"
    },
    {
      "source": "/imoveis/:city/:district/:segment",
      "destination": "/api/handler?__path=/api/seo2/imoveis/:city/:district/:segment"
    },
    {
      "source": "/imoveis/:city/:district",
      "destination": "/api/handler?__path=/api/seo2/imoveis/:city/:district"
    },
    {
      "source": "/imoveis/:city",
      "destination": "/api/handler?__path=/api/seo2/imoveis/:city"
    },
    {
      "source": "/cadastro",
      "destination": "/cadastro.html"
    },
    {
      "source": "/cadastro/",
      "destination": "/cadastro.html"
    },
    {
      "source": "/((?!api).*)",
      "destination": "/index.html"
    }
  ]
}
