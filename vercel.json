{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd packages/web && bun test src/api/agent/link-captacao-owner.test.ts && bunx tsc --noEmit && cd ../.. && bun run build:api && cd packages/web && bunx vite build",
  "outputDirectory": "packages/web/dist",
  "rewrites": [
    {
      "source": "/proposta",
      "destination": "/proposta.html"
    },
    {
      "source": "/proposta/",
      "destination": "/proposta.html"
    },
    {
      "source": "/locacao/",
      "destination": "/locacao.html"
    },
    {
      "source": "/locacao",
      "destination": "/locacao.html"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/handler?__path=/api/:path*"
    },
    {
      "source": "/feed/:file",
      "destination": "/api/handler?__path=/api/feed/:file"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/handler?__path=/api/sitemap.xml"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/handler?__path=/api/robots.txt"
    },
    {
      "source": "/imovel/:slug",
      "destination": "/api/handler?__path=/api/prerender/imovel/:slug"
    },
    {
      "source": "/autorizacao",
      "destination": "/autorizacao.html"
    },
    {
      "source": "/autorizacao-venda",
      "destination": "/autorizacao.html"
    },
    {
      "source": "/autorizar",
      "destination": "/autorizacao.html"
    },
    {
      "source": "/captar",
      "destination": "/formulario.html"
    },
    {
      "source": "/captar/",
      "destination": "/formulario.html"
    },
    {
      "source": "/formulario-imovel/:token",
      "destination": "/formulario.html"
    },
    {
      "source": "/((?!api).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/handler.mjs": {
      "includeFiles": "api/bin/**",
      "maxDuration": 300
    }
  },
  "redirects": [
    {
      "source": "/cadastro",
      "destination": "/captar",
      "permanent": false
    },
    {
      "source": "/cadastro/",
      "destination": "/captar",
      "permanent": false
    },
    {
      "source": "/link-captacao",
      "destination": "/captar",
      "permanent": false
    },
    {
      "source": "/link-captacao/",
      "destination": "/captar",
      "permanent": false
    },
    {
      "source": "/link-captacao/:token",
      "destination": "/formulario-imovel/:token",
      "permanent": false
    }
  ]
}
